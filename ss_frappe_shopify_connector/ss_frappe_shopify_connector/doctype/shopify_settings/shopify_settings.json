{
 "doctype": "DocType",
 "name": "Shopify Settings",
 "module": "SS Frappe Shopify Connector",
 "autoname": "field:store_url",
 "engine": "InnoDB",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "store_url",
   "fieldtype": "Data",
   "label": "Store URL",
   "reqd": 1,
   "unique": 1,
   "description": "e.g. xxx.myshopify.com (no https://)"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nError\nDisabled",
   "default": "Active",
   "read_only": 1
  },
  {
   "fieldname": "section_break_creds",
   "fieldtype": "Section Break",
   "label": "API Credentials"
  },
  {
   "fieldname": "client_id",
   "fieldtype": "Data",
   "label": "Client ID",
   "reqd": 1
  },
  {
   "fieldname": "client_secret",
   "fieldtype": "Password",
   "label": "Client Secret",
   "reqd": 1
  },
  {
   "fieldname": "section_break_token",
   "fieldtype": "Section Break",
   "label": "Access Token"
  },
  {
   "fieldname": "access_token",
   "fieldtype": "Password",
   "label": "Access Token",
   "read_only": 1
  },
  {
   "fieldname": "token_expires_at",
   "fieldtype": "Datetime",
   "label": "Token Expires At",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_refreshed_on",
   "fieldtype": "Datetime",
   "label": "Last Refreshed On",
   "read_only": 1
  },
  {
   "fieldname": "section_break_sync",
   "fieldtype": "Section Break",
   "label": "Order & Product Sync Defaults"
  },
  {
   "fieldname": "default_customer",
   "fieldtype": "Link",
   "label": "Default Customer",
   "options": "Customer",
   "reqd": 1,
   "description": "All Shopify orders will be created against this ERPNext Customer."
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "column_break_sync_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_warehouse",
   "fieldtype": "Link",
   "label": "Default Warehouse",
   "options": "Warehouse",
   "reqd": 1
  },
  {
   "fieldname": "price_list",
   "fieldtype": "Link",
   "label": "Selling Price List",
   "options": "Price List",
   "reqd": 1
  },
  {
   "fieldname": "section_break_webhook",
   "fieldtype": "Section Break",
   "label": "Order Webhook"
  },
  {
   "fieldname": "webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Signing Secret",
   "description": "The 'Signing secret' shown in Shopify Admin > Settings > Notifications > Webhooks. Used to verify that incoming order webhooks really came from Shopify."
  },
  {
   "fieldname": "column_break_webhook_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "webhook_url",
   "fieldtype": "Data",
   "label": "Webhook URL (read-only, copy into Shopify)",
   "read_only": 1,
   "description": "Paste this as the URL when creating the 'Order creation' webhook in Shopify Admin."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "share": 1
  }
 ]
}
